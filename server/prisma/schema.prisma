generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  role         String   @default("operator") // super_admin, warehouse_admin, operator
  realName     String?
  phone        String?
  warehouseId  Int?
  warehouse    Warehouse? @relation(fields: [warehouseId], references: [id])
  createdById  Int?
  createdBy    User?    @relation("CreatedUsers", fields: [createdById], references: [id])
  operatorType String?  // warehouse=库人员(仅移动端), clerk=文员(仅桌面端合同)
  desktopTokenVersion Int @default(0)  // 桌面端登录版本号
  mobileTokenVersion  Int @default(0)  // 移动端登录版本号
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // relations
  createdUsers       User[]            @relation("CreatedUsers")
  managedWarehouses  Warehouse[]       @relation("WarehouseManager")
  reviewedTransfers  TransferOrder[]   @relation("TransferReviewer")
  inboundOrders      InboundOrder[]    @relation("InboundOperator")
  outboundOrders     OutboundOrder[]   @relation("OutboundOperator")
  transferOrders     TransferOrder[]   @relation("TransferOperator")
  checkTasks         CheckTask[]       @relation("CheckOperator")

  @@index([warehouseId])
  @@index([createdById])
  @@index([role])
}

model Warehouse {
  id         Int       @id @default(autoincrement())
  name       String
  address    String?
  managerId  Int?
  manager    User?     @relation("WarehouseManager", fields: [managerId], references: [id])
  customerId Int?
  customer   Customer? @relation(fields: [customerId], references: [id])
  createdAt  DateTime  @default(now())

  users           User[]
  productWarehouses ProductWarehouse[]
  locations       Location[]
  inventories     Inventory[]
  inboundOrders   InboundOrder[]
  outboundOrders  OutboundOrder[]
  fromTransfers   TransferOrder[]   @relation("FromWarehouse")
  toTransfers     TransferOrder[]   @relation("ToWarehouse")
  checkTasks      CheckTask[]

  @@index([customerId])
}

model Category {
  id         Int        @id @default(autoincrement())
  name       String
  parentId   Int?
  parent     Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children   Category[] @relation("CategoryTree")
  customerId Int?
  customer   Customer?  @relation(fields: [customerId], references: [id])
  products   Product[]

  @@index([parentId])
  @@index([customerId])
}

model Product {
  id         Int      @id @default(autoincrement())
  sku        String
  name       String
  spec       String?
  unit       String   @default("pcs")
  barcode    String?
  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id])
  customerId Int?
  customer   Customer? @relation(fields: [customerId], references: [id])
  safetyStock Int    @default(0)
  costPrice  Float?
  salePrice  Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  imageUrl   String?   // 商品图片路径（本地上传）
  expiryDate        DateTime? // 保质期截止日（null=无保质期）
  expiryWarningDays Int      @default(30) // 提前预警天数

  productWarehouses ProductWarehouse[]
  contractItems  ContractItem[]
  containerItems ContainerItem[]
  inventories    Inventory[]
  inboundItems   InboundItem[]
  outboundItems  OutboundItem[]
  transferItems  TransferItem[]
  stockLogs      StockLog[]
  checkItems     CheckItem[]

  @@index([name])
  @@index([barcode])
  @@index([categoryId])
  @@index([customerId])
}

model ProductWarehouse {
  id          Int       @id @default(autoincrement())
  productId   Int
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  safetyStock Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([productId, warehouseId])
  @@index([warehouseId])
}

model Inventory {
  id          Int       @id @default(autoincrement())
  productId   Int
  product     Product   @relation(fields: [productId], references: [id])
  warehouseId Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  locationId  Int?
  location    Location? @relation(fields: [locationId], references: [id])
  quantity    Int       @default(0)
  batchNo     String?   // 批次号，如 CON001-20260528
  updatedAt   DateTime  @updatedAt

  @@unique([productId, warehouseId, locationId, batchNo])

  @@index([warehouseId])
  @@index([productId])
  @@index([quantity])
}

model InboundOrder {
  id          Int      @id @default(autoincrement())
  orderNo     String
  warehouseId Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  supplier    String?
  operatorId  Int?
  operator    User?    @relation("InboundOperator", fields: [operatorId], references: [id])
  status      String   @default("draft") // draft, confirmed
  locationId  Int?
  location    Location? @relation(fields: [locationId], references: [id])
  note        String?
  createdAt   DateTime @default(now())

  items InboundItem[]

  @@index([warehouseId])
  @@index([status])
  @@index([createdAt])
}

model InboundItem {
  id         Int          @id @default(autoincrement())
  inboundId  Int
  inbound    InboundOrder @relation(fields: [inboundId], references: [id])
  productId  Int
  product    Product      @relation(fields: [productId], references: [id])
  quantity   Int
  unitPrice  Float?
  locationId Int?
  location   Location?    @relation(fields: [locationId], references: [id])
  expiryDate DateTime?
  contractId  Int?
  contract    Contract?  @relation(fields: [contractId], references: [id])
  batchNo     String?

  @@index([inboundId])
}

model OutboundOrder {
  id          Int      @id @default(autoincrement())
  orderNo     String
  warehouseId Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  receiver    String?  // 领用人/部门
  operatorId  Int?
  operator    User?    @relation("OutboundOperator", fields: [operatorId], references: [id])
  status      String   @default("draft") // draft, confirmed
  locationId  Int?
  location    Location? @relation(fields: [locationId], references: [id])
  containerId Int?
  container   Container? @relation(fields: [containerId], references: [id])
  containerNo String?   // 排柜编号（文本匹配用）
  note        String?
  createdAt   DateTime @default(now())

  items OutboundItem[]

  @@index([warehouseId])
  @@index([status])
  @@index([createdAt])
  @@index([containerId])
}

model OutboundItem {
  id         Int          @id @default(autoincrement())
  outboundId Int
  outbound   OutboundOrder @relation(fields: [outboundId], references: [id])
  productId  Int
  product    Product       @relation(fields: [productId], references: [id])
  quantity   Int
  locationId Int?
  location   Location?    @relation(fields: [locationId], references: [id])
  contractId Int?
  contract   Contract?    @relation(fields: [contractId], references: [id])
  batchNo    String?

  @@index([outboundId])
  @@index([contractId])
}

model TransferOrder {
  id              Int      @id @default(autoincrement())
  orderNo         String
  fromWarehouseId Int
  fromWarehouse   Warehouse @relation("FromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouseId   Int
  toWarehouse     Warehouse @relation("ToWarehouse", fields: [toWarehouseId], references: [id])
  operatorId      Int?
  operator        User?    @relation("TransferOperator", fields: [operatorId], references: [id])
  status          String   @default("draft") // draft, pending, approved, rejected
  note            String?
  reviewedById    Int?
  reviewedBy      User?    @relation("TransferReviewer", fields: [reviewedById], references: [id])
  reviewNote      String?
  reviewedAt      DateTime?
  createdAt       DateTime @default(now())

  items TransferItem[]

  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([status])
}

model TransferItem {
  id         Int           @id @default(autoincrement())
  transferId Int
  transfer   TransferOrder @relation(fields: [transferId], references: [id])
  productId  Int
  product    Product       @relation(fields: [productId], references: [id])
  quantity   Int
  locationId Int?
  location   Location?     @relation(fields: [locationId], references: [id])

  @@index([transferId])
}

model StockLog {
  id          Int      @id @default(autoincrement())
  productId   Int
  product     Product  @relation(fields: [productId], references: [id])
  warehouseId Int
  changeQty   Int      // 变动数量（正=入库，负=出库）
  beforeQty   Int
  afterQty    Int
  type        String   // inbound, outbound, transfer_in, transfer_out, check_adjust, container_return, container_adjust
  refId       Int?     // 关联单据 ID
  refNo       String?  // 关联单据编号（如排柜编号、单号）
  createdAt   DateTime @default(now())

  @@index([productId])
  @@index([warehouseId])
  @@index([createdAt])
}

model CheckTask {
  id           Int        @id @default(autoincrement())
  warehouseId  Int
  warehouse    Warehouse  @relation(fields: [warehouseId], references: [id])
  operatorId   Int?
  operator     User?      @relation("CheckOperator", fields: [operatorId], references: [id])
  status       String     @default("in_progress") // in_progress, completed, anomaly
  locationId   Int?
  location     Location?  @relation(fields: [locationId], references: [id])
  parentTaskId Int?       // null=主任务, 有值=子任务
  parentTask   CheckTask? @relation("SubTasks", fields: [parentTaskId], references: [id])
  subTasks     CheckTask[] @relation("SubTasks")
  note         String?
  reviewNote   String?    // 异常确认时的备注
  createdAt    DateTime   @default(now())

  items CheckItem[]

  @@index([warehouseId])
  @@index([parentTaskId])
}

model CheckItem {
  id        Int       @id @default(autoincrement())
  taskId    Int
  task      CheckTask @relation(fields: [taskId], references: [id])
  productId Int
  product   Product   @relation(fields: [productId], references: [id])
  systemQty Int
  actualQty Int?
  diffQty   Int?

  @@index([taskId])
}

model Location {
  id          Int      @id @default(autoincrement())
  warehouseId Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  name        String
  code        String
  createdAt   DateTime @default(now())

  inventories     Inventory[]
  inboundOrders   InboundOrder[]
  inboundItems    InboundItem[]
  outboundOrders  OutboundOrder[]
  outboundItems   OutboundItem[]
  transferItems   TransferItem[]
  checkTasks      CheckTask[]
  containerItemsSource  ContainerItem[] @relation("ContainerItemSource")
  containerItemsReturn  ContainerItem[] @relation("ContainerItemReturn")

  @@index([warehouseId])
}

model Customer {
  id            Int       @id @default(autoincrement())
  username      String    @unique
  passwordHash  String
  realName      String?
  phone         String?
  status        String    @default("active") // active | suspended
  maxWarehouses Int       @default(1)
  expiresAt     DateTime? // null=永久，到期自动暂停
  serverHost    String?   // null=本机, s2.cgklxt.top=其他服务器
  createdBy     Int?
  createdAt     DateTime  @default(now())
  deletedAt     DateTime? // null=正常, 非null=软删除（7天后彻底清理）
  reportTemplate String?   // 装柜报表自定义HTML模板，null=默认
  templatePreset String?   // 预设模板: manifest | packing-list | shipping-detail
  excelPreset    String?   // Excel导出预设: manifest | packing-list | shipping-detail（独立于HTML模板）
  exportTemplate String?   // Excel导出自定义列配置JSON，null=用预设

  warehouses Warehouse[]
  categories Category[]
  products   Product[]
  contracts  Contract[]
  containers  Container[]

  @@index([createdBy])
}

model Sequence {
  name     String @id
  nextVal  Int    @default(1)
}

model Setting {
  key   String @id
  value String
}

model Contract {
  id                 Int              @id @default(autoincrement())
  contractNo         String
  customerId         Int
  customer           Customer         @relation(fields: [customerId], references: [id])
  businessCustomerId Int              @default(0)
  status             String           @default("active") // active, completed, cancelled
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  items              ContractItem[]
  inboundItems       InboundItem[]
  outboundItems      OutboundItem[]
  containerContracts ContainerContract[]

  @@unique([contractNo, customerId])
  @@index([customerId])
  @@index([businessCustomerId])
  @@index([status])
}

model ContractItem {
  id          Int      @id @default(autoincrement())
  contractId  Int
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product  @relation(fields: [productId], references: [id])
  plannedQty  Int
  receivedQty Int      @default(0)
  unitPrice   Float?   // 合同批次单价

  @@unique([contractId, productId])
}

model Container {
  id                 Int              @id @default(autoincrement())
  containerNo        String
  actualContainerNo  String?          // 真实车辆货柜号，封柜时填写
  toYardTime         DateTime?
  sealTime           DateTime?
  status             String           @default("pending") // pending, loading, sealed, cancelled
  note               String?
  customerId         Int
  customer           Customer         @relation(fields: [customerId], references: [id])
  businessCustomerId Int               @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  items              ContainerItem[]
  outbounds          OutboundOrder[]
  contracts          ContainerContract[]

  @@unique([containerNo, customerId])
  @@index([customerId])
  @@index([businessCustomerId])
  @@index([status])
}

model ContainerContract {
  id          Int       @id @default(autoincrement())
  containerId Int
  container   Container @relation(fields: [containerId], references: [id], onDelete: Cascade)
  contractId  Int
  contract    Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([containerId, contractId])
  @@index([contractId])
}

model ContainerItem {
  id          Int       @id @default(autoincrement())
  containerId Int
  container   Container @relation(fields: [containerId], references: [id], onDelete: Cascade)
  outboundId  Int
  productId   Int
  product     Product   @relation(fields: [productId], references: [id])
  plannedQty  Int
  actualQty   Int?
  returnedQty    Int       @default(0)
  locationId     Int?
  location       Location? @relation("ContainerItemSource", fields: [locationId], references: [id])
  returnLocationId Int?
  returnLocation Location? @relation("ContainerItemReturn", fields: [returnLocationId], references: [id])
  batchNo        String?

  @@index([outboundId])
  @@index([containerId])
}

model BusinessCustomer {
  id        Int      @id @default(autoincrement())
  realName  String
  tenantId  Int
  createdAt DateTime @default(now())

  @@unique([realName, tenantId])
  @@index([tenantId])
}
